# ============================================================
# Variables de entorno — copia este archivo a .env y rellena.
# El .env real NUNCA se sube a git (ver .gitignore).
# En Coolify se definen como "Build Variables" (build-time).
# ============================================================

# URL pública del sitio (para OG tags, canonical, sitemap). Sin slash final.
# Coolify (dominio raíz):   https://couva.148-72-153-91.sslip.io  +  PUBLIC_BASE_PATH=/
# GitHub Pages (subruta):   https://oscaromargp.github.io          +  PUBLIC_BASE_PATH=/couva-landing
PUBLIC_SITE_URL=https://couva.148-72-153-91.sslip.io
PUBLIC_BASE_PATH=/

# Webhook de n8n que recibe los formularios (lead + referidos) → notifica por Telegram/Gmail/Sheets.
# Lo usa el navegador (prefijo PUBLIC_). Es una URL pública por diseño; la protección
# (honeypot/anti-spam) vive DENTRO del workflow de n8n.
PUBLIC_N8N_WEBHOOK_URL=https://n8n.148-72-153-91.sslip.io/webhook/couva-lead

# Webhook del cerebro de chat IA en n8n (AI Agent + OpenRouter). También público por diseño.
PUBLIC_N8N_CHAT_URL=https://n8n.148-72-153-91.sslip.io/webhook/couva-chat

# Link público de agenda (Google Calendar appointment).
PUBLIC_CALENDAR_URL=https://calendar.app.google/T3QKi6h9VhtzSRDeA

# --- Marketing / medición (opcionales; el sitio los activa solo si existen) ---
# Google Analytics 4 (formato G-XXXXXXX)
PUBLIC_GA4_ID=
# Meta Pixel ID (número de ~15 dígitos). El token de CAPI va en n8n, NO aquí.
PUBLIC_META_PIXEL_ID=

# --- Supabase (claves públicas; el contador de visitas las usa en el navegador) ---
PUBLIC_SUPABASE_URL=https://aekdukfjftzbbrixuqbk.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable__QHR3TiiXE5i4ECjTMFkSA_uWrAV8F0

# ============================================================
# SECRETOS DEL SERVIDOR (NO van aquí ni en el frontend) — viven en n8n:
#   · OPENROUTER_API_KEY  → credencial "OpenRouter" del nodo del modelo de chat
#   · Telegram Bot Token  → credencial "COUVA Telegram Bot"
# ============================================================
